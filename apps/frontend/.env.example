# CareNest Production Environment Configuration
NEXT_PUBLIC_APP_NAME="CareNest"
NEXT_PUBLIC_APP_TAGLINE="Care at Home. Peace of Mind."

# Backend API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Supabase Cloud Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Feature Flags
NEXT_PUBLIC_ENABLE_SENIOR_VOICE_ASSIST=true
NEXT_PUBLIC_ENABLE_LIVE_GPS_SIMULATION=true
