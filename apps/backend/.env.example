# CareNest AI Backend Environment Configuration
# ==========================================================

# 1. Application Settings
PROJECT_NAME="CareNest AI Backend"
APP_ENV="production"                # "production" or "development"
DEBUG=False                         # Set to False in production
API_PREFIX="/api"
PORT=8000                           # Render automatically provides $PORT dynamically
HOST="0.0.0.0"                      # Bind to all interfaces for Render

# 2. Database Configuration
# ----------------------------------------------------------
# Option A: Local Development / Render with Persistent Disk (SQLite)
# DATABASE_URL="sqlite:///./carenest.db"
# Or with Render Persistent Disk mounted at /var/data:
# DATABASE_URL="sqlite:////var/data/carenest.db"
#
# Option B: Cloud PostgreSQL (Recommended for Render - Supabase or Render PostgreSQL)
# Both postgresql:// and postgres:// formats are supported automatically
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL="sqlite:///./carenest.db"

# Automatic demo data seeding on startup (creates initial demo accounts if database is empty)
# Set to false to disable demo seeding on a production database
AUTO_SEED=true

# 3. Authentication & JWT Security
# ----------------------------------------------------------
# Generate a strong 32+ character random secret for production (e.g., openssl rand -hex 32)
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key_minimum_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080    # 7 days

# 4. CORS Settings (Allowed Frontend Origins)
# ----------------------------------------------------------
# Comma-separated list or JSON array of allowed frontend URLs.
# Include your Vercel deployment URL and local development origins.
# (Do NOT use trailing slashes; the system automatically strips them defensively)
ALLOWED_ORIGINS="https://your-carenest-frontend.vercel.app,http://localhost:3000,http://127.0.0.1:3000"

# 5. Optional AI Service Configuration
# ----------------------------------------------------------
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="hybrid"                # "gemini", "openai", or "hybrid" / "clinical_rule_engine"

# 6. Optional Supabase Project Credentials (if using Supabase Auth / Storage)
# ----------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
