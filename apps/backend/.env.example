# Application Settings
PROJECT_NAME="CareNest AI Backend"
APP_ENV="production"
DEBUG=False
API_PREFIX="/api"
PORT=8000
HOST="0.0.0.0"

# Database Configuration:
# For Local Development (SQLite):
# DATABASE_URL="sqlite:///./carenest.db"
#
# For Production Cloud (Supabase PostgreSQL):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL="sqlite:///./carenest.db"

# JWT Security Key (Replace with strong random secret in production)
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key_minimum_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase Project Credentials (Backend Service Access)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# CORS Settings (JSON list or comma-separated allowed origins)
ALLOWED_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "https://your-deployed-domain.com"]'
