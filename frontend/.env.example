# CareNest AI Frontend Environment Configuration (Vercel & Local)
# ==============================================================

NEXT_PUBLIC_APP_NAME="CareNest AI"
NEXT_PUBLIC_APP_TAGLINE="Care at Home. Peace of Mind."

# Backend API Endpoint
# --------------------------------------------------------------
# For Local Development:
# NEXT_PUBLIC_API_URL="http://localhost:8000/api"
#
# For Production Deployment on Vercel:
# Set this in your Vercel Project Settings -> Environment Variables:
# NEXT_PUBLIC_API_URL="https://[YOUR-RENDER-SERVICE-NAME].onrender.com/api"
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Optional: Next.js Server-Side Proxy / Rewrite Target
# BACKEND_INTERNAL_URL="https://[YOUR-RENDER-SERVICE-NAME].onrender.com"

# Supabase Cloud Database & Auth Configuration (Optional)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Feature Flags
NEXT_PUBLIC_ENABLE_SENIOR_VOICE_ASSIST=true
NEXT_PUBLIC_ENABLE_LIVE_GPS_SIMULATION=true
